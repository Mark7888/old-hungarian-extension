{
    "compilerOptions": {
        "target": "ES2017",
        "module": "ES2015",
        "moduleResolution": "bundler",
        "lib": [
            "ES2017",
            "DOM"
        ],
        "strict": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "skipLibCheck": true
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}